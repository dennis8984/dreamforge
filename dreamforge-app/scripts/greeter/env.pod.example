# Copy to ~/dreamforge-greeter/.env on the pod. Do not commit the filled-in file.

# Shared secret DreamForge sends as Authorization: Bearer.
# Generate with: openssl rand -hex 32
GREETER_API_TOKEN=

# Public port. Point the Runpod HTTP proxy at this port only.
PROXY_PORT=8790

# 48 GB GPU: nvfp4-fast. RTX 5090 32 GB: nvfp4-32gb (LLM and TTS must leave that GPU).
GATEWAY_PRESET=nvfp4-fast

# AivisSpeech. Confirm an English speaker before going live.
TTS_URL=http://127.0.0.1:10101
TTS_SPEAKER_ID=888753760

# OpenAI-compatible Gemma 4 with input_audio. llama.cpp --parallel 2 or higher.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=

# Saved in the narration UI after the idle pool is built. 32 hex characters.
GREETER_PRESET_ID=
