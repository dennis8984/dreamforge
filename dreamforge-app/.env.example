# Example environment variables
# Copy this file to .env.local for development or .env.production for production

# Runpod API Configuration
RUNPOD_API_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/run
RUNPOD_API_KEY=your_runpod_api_key_here

# Nano Banana API Key (Google Gemini)
NANO_BANANA_API_KEY=your_nano_banana_api_key_here

# Next.js Public Variables (accessible in browser)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_API_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/run

# Optional: Supabase Configuration (if using database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Optional: Stripe Configuration (if using payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key