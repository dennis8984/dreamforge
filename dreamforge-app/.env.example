# DreamForge Environment Variables
# Copy this file to .env.local for development or set in Vercel for production

# Supabase Configuration (Required for database)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only. Admin routes need this to write characters.
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# AI Generation Configuration
# Runpod API for Stable Diffusion image generation
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_API_URL=https://api.runpod.ai/v2/your_endpoint_id/run
RUNPOD_VIDEO_API_URL=https://api.runpod.ai/v2/your_video_endpoint_id/run

# SpicyAPI: when SPICY_API_KEY is set, image and video generation use it instead of Runpod.
# Server-only: never prefix these with NEXT_PUBLIC_.
# Requires migration 018 and NEXT_PUBLIC_APP_URL (HTTPS) for webhooks.
SPICY_API_KEY=
# From SpicyAPI Console > Webhooks. Without it, results are only saved while a page is polling.
SPICY_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=https://your-domain.example
# Image: qwen-image-2512 (default), minimax-h3-image, z-image-turbo, seedream-5-pro
# SPICY_IMAGE_MODEL=qwen-image-2512
# Images made from a character's reference photos, plus the first image of a starter set made
# from a description. Requests with LoRAs stay on SPICY_IMAGE_MODEL,
# because Seedream can't run LoRAs.
# SPICY_REFERENCE_IMAGE_MODEL=seedream-5-pro
# MiniMax H3: 1k (default) or 2k. Seedream: 1k, 1.5k or 2k (default). Other models ignore this.
# SPICY_IMAGE_RESOLUTION=1k
# Video: minimax-h3 (default), minimax-h3-singularity, wan-2.2
# SPICY_VIDEO_MODEL=minimax-h3
# MiniMax H3: 480p, 540p, 768p (default), 1080p. Wan 2.2: 480p, 720p (default).
# SPICY_VIDEO_RESOLUTION=768p

# Content checks run through SpicyAPI, on SPICY_API_KEY above. Without that key, moderated
# requests are rejected with "checker_unavailable".
# Optional override for the first classifier model.
# MODERATION_MODEL=anthropic/claude-haiku-5.5/chat

# Optional: Seedream/RunComfy for animated GIF generation
# RUNCOMFY_API_URL=https://api.runcomfy.com/...
# RUNCOMFY_API_KEY=your_runcomfy_api_key

# Optional: Stripe Configuration (if using payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Realtime video greeter (Runpod pod). Server-only. See scripts/greeter/README.md.
# GREETER_CONVERSATION_URL=https://<pod>-8790.proxy.runpod.net/conversation
# GREETER_NARRATION_URL=https://<pod>-8790.proxy.runpod.net/narration
# GREETER_PRESET_ID=
# GREETER_API_TOKEN=
# GREETER_IDLE_URLS=https://example.com/idle-000.mp4,https://example.com/idle-001.mp4
# GREETER_NAME=Lila