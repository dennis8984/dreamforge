{
  "buildCommand": "cd dreamforge-app && npm run build",
  "outputDirectory": "dreamforge-app/.next",
  "installCommand": "cd dreamforge-app && npm install",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/py/:path*",
      "destination": "https://dreamforge-api.runpod.io/:path*"
    }
  ],
  "functions": {
    "dreamforge-app/app/api/*.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "RUNPOD_API_KEY": "@runpod_api_key",
    "RUNPOD_API_URL": "@runpod_api_url",
    "NANO_BANANA_API_KEY": "@nano_banana_api_key"
  }
}